#!/usr/bin/env python3
"""
build_boq_workbook.py
=====================
Rebuilds `boq-template.xlsx` (6 sheets) from `boq-template.csv`.

The CSV is the single source of truth. Nothing is hard-coded here except sheet
names, column layouts, validation vocabularies and formatting. Edit the CSV,
re-run this script, and the workbook follows.

Authority: `sa-estimation-norms.md` v2.0 (2026-10-01). Section references in
this file use the § character, matching the CSV.

Usage
-----
    python build_boq_workbook.py                 # build, backing up any existing file
    python build_boq_workbook.py --no-backup     # overwrite without keeping a copy
    python build_boq_workbook.py --check-only    # parse + self-check, write nothing

Exit codes: 0 ok · 1 self-check failure · 2 parse failure
"""

from __future__ import annotations

import argparse
import csv
import io
import re
import shutil
import sys
from datetime import date
from pathlib import Path

try:
    from openpyxl import Workbook
    from openpyxl.formatting.rule import FormulaRule
    from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
    from openpyxl.utils import get_column_letter
    from openpyxl.worksheet.datavalidation import DataValidation
except ImportError:  # pragma: no cover
    sys.exit("openpyxl is required.  Install it with:  pip install openpyxl")


HERE = Path(__file__).resolve().parent
CSV_PATH = HERE / "boq-template.csv"
XLSX_PATH = HERE / "boq-template.xlsx"

# ---------------------------------------------------------------------------
# Vocabularies — §23 status list and §13 rule 6 area bases. These are the only
# values a cell may contain; the dropdowns enforce them.
# ---------------------------------------------------------------------------

STATUSES = [
    "verified",
    "derived",
    "assumed",
    "by-schedule",
    "by-client-spec",
    "excluded",
]

BASES = ["plan", "slope", "gross face", "net face", "net", "developed girth", "n/a"]

UNITS = [
    "m3", "m2", "lin. m", "No", "kg", "bags", "sheets", "tonnes",
    "mixed", "excluded", "n/a",
]

# §0.2 wastage defaults plus the ranges it allows.
WASTAGE = [0, 5, 7, 8, 10, 12, 15]

SHEET_ORDER = ["Summary", "BOQ", "Take-off", "Assumptions & Verify", "Norms", "Output"]

BOQ_HEADER = [
    "Item No", "Description", "Unit", "Quantity", "Wastage %", "Total Qty",
    "Formula", "Citation", "Basis", "Status",
]

TAKEOFF_HEADER = [
    "Element", "Length m", "Width m", "Height/Depth m", "Pitch factor",
    "Bulking factor", "Rates (from norms)", "Gross", "Deductions", "Net",
    "Unit", "Formula", "Rounding / Order Qty",
]

# ---------------------------------------------------------------------------
# Styling
# ---------------------------------------------------------------------------

HDR_FILL = PatternFill("solid", fgColor="1F3864")
HDR_FONT = Font(bold=True, color="FFFFFF", size=10)
TITLE_FONT = Font(bold=True, size=13, color="1F3864")
NOTE_FONT = Font(italic=True, size=9, color="595959")
BAND_FILL = PatternFill("solid", fgColor="F2F5FA")
WARN_FILL = PatternFill("solid", fgColor="FFF2CC")
BAD_FILL = PatternFill("solid", fgColor="FCE4E4")
OK_FILL = PatternFill("solid", fgColor="E2EFDA")
THIN = Side(style="thin", color="BFBFBF")
BOX = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)

TAB_COLOURS = {
    "Summary": "1F3864",
    "BOQ": "2E75B6",
    "Take-off": "2E75B6",
    "Assumptions & Verify": "BF8F00",
    "Norms": "BF8F00",
    "Output": "C00000",
}


def num(value: str):
    """'9.23' -> 9.23,  '?' -> '?',  '20800' -> 20800. Never guesses."""
    v = value.strip()
    if v in ("", "?"):
        return "?" if v == "?" else None
    try:
        f = float(v)
    except ValueError:
        return v
    return int(f) if f.is_integer() and "." not in v else f


# ---------------------------------------------------------------------------
# CSV parsing
# ---------------------------------------------------------------------------

class ParseError(Exception):
    pass


def read_lines() -> list[str]:
    if not CSV_PATH.exists():
        raise ParseError(f"CSV not found: {CSV_PATH}")
    return CSV_PATH.read_text(encoding="utf-8").splitlines()


def find_header_row(lines: list[str], signature: str) -> int:
    """Last occurrence of a header that is followed by data rows.

    The CSV repeats some header strings inside prose blocks, so the first
    textual match is not always the real header.
    """
    hits = [i for i, ln in enumerate(lines) if ln.strip().startswith(signature)]
    if not hits:
        raise ParseError(f"header starting '{signature}' not found in {CSV_PATH.name}")
    for i in reversed(hits):
        if any(lines[j].strip() for j in range(i + 1, min(i + 4, len(lines)))):
            return i
    return hits[-1]


def collect_table(lines: list[str], start: int, ncols: int,
                  stop_markers: tuple[str, ...]) -> list[list]:
    """Rows after `start`, stopping at a line matching any stop marker.

    `start` is the section marker line itself; its inline content after a
    colon supplies the first header for the Summary sheet.
    """
    rows: list[list] = []
    for ln in lines[start + 1:]:
        s = ln.strip()
        if not s:
            continue
        if any(s.startswith(m) for m in stop_markers):
            break
        if "," not in s:
            break
        row = next(csv.reader(io.StringIO(s), skipinitialspace=True))
        if len(row) != ncols:
            raise ParseError(
                f"expected {ncols} columns, got {len(row)}: {s[:90]}")
        rows.append(row)
    return rows


def parse(csv_lines: list[str]) -> dict:
    """Extract every sheet's table plus its own prose notes."""
    out: dict = {"notes": {}}

    def anchor(pred) -> int:
        for i, ln in enumerate(csv_lines):
            if pred(ln.strip()):
                return i
        raise ParseError("expected section marker not found in the CSV")

    boq_hdr = [i for i, ln in enumerate(csv_lines)
               if ln.strip().startswith("Item No,Description")]
    if len(boq_hdr) < 2:
        raise ParseError("could not locate the BOQ header row")
    boq_hdr = boq_hdr[1]
    sum_idx = anchor(lambda s: s.startswith("Summary sheet:"))
    to_idx = anchor(lambda s: s.startswith("Take-off sheet columns:"))
    av_idx = anchor(lambda s: s.startswith("Assumptions & Verify sheet:"))
    nm_idx = anchor(lambda s: s.startswith("Norms sheet:"))
    out_idx = anchor(lambda s: s.startswith("Output sheet"))

    to_hdr = anchor(lambda s: s.startswith("Element,Length m"))
    av_hdr = anchor(lambda s: s.startswith("Item,Assumption/Question"))
    nm_hdr = anchor(lambda s: s.startswith("Norm §"))

    # Prose notes belong to the section they sit in, not to everything above
    # them — slicing from line 0 would reprint the BOQ notes on every sheet.
    def notes(lo: int, hi: int) -> list[str]:
        return [ln for ln in csv_lines[lo:hi]
                if ln.strip() and "," not in ln]

    out["notes"]["BOQ"] = notes(0, boq_hdr)
    out["notes"]["Summary"] = notes(sum_idx, sum_idx + 1)
    out["notes"]["Take-off"] = notes(to_idx, to_hdr)
    out["notes"]["Assumptions & Verify"] = notes(av_idx, av_hdr)
    out["notes"]["Norms"] = notes(nm_idx, nm_hdr)

    out["BOQ"] = collect_table(csv_lines, boq_hdr, len(BOQ_HEADER),
                               stop_markers=("Summary sheet",))
    out["Summary"] = collect_table(csv_lines, sum_idx, 5,
                                   stop_markers=("Take-off sheet",))
    out["Take-off"] = collect_table(csv_lines, to_hdr, len(TAKEOFF_HEADER),
                                    stop_markers=("Assumptions & Verify sheet",))
    out["Assumptions & Verify"] = collect_table(csv_lines, av_hdr, 3,
                                                stop_markers=("Norms sheet",))
    out["Norms"] = collect_table(csv_lines, nm_hdr, 5,
                                 stop_markers=("Output sheet",))
    out["Output"] = [ln.rstrip() for ln in csv_lines[out_idx + 1:] if ln.strip()]
    return out


# ---------------------------------------------------------------------------
# Self-checks — §13 rules, run before anything is written
# ---------------------------------------------------------------------------

def self_check(data: dict) -> list[str]:
    """Return a list of human-readable problems. Empty list == pass."""
    problems: list[str] = []
    boq = data["BOQ"]

    # §23 — status vocabulary, no free text.
    for r in boq:
        if r[9].strip() not in STATUSES:
            problems.append(f"BOQ {r[0]}: illegal status {r[9]!r} (§23)")

    # §13 rule 6 — basis must be stated on every row.
    for r in boq:
        if r[8].strip() not in BASES:
            problems.append(f"BOQ {r[0]}: basis {r[8]!r} not in §13 rule 6 list")

    # §13 rule 5 — wastage must not be baked into the formula.
    for r in boq:
        if re.search(r"\+\s*\d+\s*%", r[6]):
            problems.append(
                f"BOQ {r[0]}: wastage inside the Formula cell — apply it once, "
                f"in the 'Wastage %' column only (§13 rule 5)")

    # §23 — every assumed / by-schedule / by-client-spec row needs a Verify row.
    verify_blob = " ".join(" ".join(r) for r in data["Assumptions & Verify"])
    blanket = "All" in verify_blob
    for r in boq:
        st = r[9].strip()
        if st in ("assumed", "by-schedule", "by-client-spec"):
            if r[0] not in verify_blob and not blanket:
                problems.append(
                    f"BOQ {r[0]}: status '{st}' has no Assumptions & Verify row (§23)")

    # Every BOQ row must be fully populated (§13 rule 8 — no blanks).
    for r in boq:
        for i, cell in enumerate(r):
            if not cell.strip() and not (i in (3, 5)):
                problems.append(
                    f"BOQ {r[0]}: blank {BOQ_HEADER[i]} (§13 rule 8 — no blanks)")

    # Unknown quantities must be '?', never a silent zero or a guess.
    for r in boq:
        if r[5].strip() in ("0", "0.0") and r[3].strip() == "?":
            problems.append(f"BOQ {r[0]}: unknown quantity but Total Qty is 0")

    # §13 rule 5 — Total Qty must equal Quantity x (1 + Wastage %), wastage
    # applied exactly once. Reports the CSV's own arithmetic slips.
    for r in boq:
        q, w, t = r[3].strip(), r[4].strip(), r[5].strip()
        try:
            qf, wf, tf = float(q), float(w), float(t)
        except ValueError:
            continue                      # '?' rows are checked above
        expect = round(qf * (1 + wf / 100) + 1e-9, 2)
        if abs(expect - tf) > 0.005:
            problems.append(
                f"BOQ {r[0]}: Total Qty {tf} != {q} x (1 + {w}%) = {expect} "
                f"— wastage must be applied once, in the Wastage % column")

    return problems


# ---------------------------------------------------------------------------
# Sheet builders
# ---------------------------------------------------------------------------

def write_header(ws, headers: list[str], row: int = 1) -> None:
    for c, h in enumerate(headers, start=1):
        cell = ws.cell(row=row, column=c, value=h)
        cell.fill = HDR_FILL
        cell.font = HDR_FONT
        cell.alignment = Alignment(horizontal="center", vertical="center",
                                   wrap_text=True)
        cell.border = BOX
    ws.row_dimensions[row].height = 30


def write_notes(ws, notes: list[str], row: int = 1) -> int:
    """Write the scope banner + column notes; return the next free row."""
    ws.cell(row=row, column=1,
            value="MATERIALS TAKE-OFF ONLY — NOT A PRICED BOQ (§22). "
                  "No rate or price column exists in this workbook by design."
            ).font = TITLE_FONT
    row += 1
    for n in notes:
        ws.cell(row=row, column=1, value=n.strip()).font = NOTE_FONT
        row += 1
    return row + 1


def widths(ws, spec: dict[str, int]) -> None:
    for col, w in spec.items():
        ws.column_dimensions[col].width = w


def add_list_validation(ws, col_letter: str, first: int, last: int,
                        values: list[str], title: str, prompt: str) -> None:
    dv = DataValidation(
        type="list",
        formula1='"' + ",".join(values) + '"',
        allow_blank=False,
        showDropDown=False,          # False == the arrow IS shown in Excel
        showErrorMessage=True,
        errorTitle=f"Invalid {title}",
        error=prompt,
        showInputMessage=True,
        promptTitle=title,
        prompt=prompt,
    )
    ws.add_data_validation(dv)
    dv.add(f"{col_letter}{first}:{col_letter}{last}")


def build_boq(wb: Workbook, data: dict) -> None:
    ws = wb.create_sheet("BOQ")
    ws.sheet_properties.tabColor = TAB_COLOURS["BOQ"]
    start = write_notes(ws, data["notes"].get("BOQ", []))
    write_header(ws, BOQ_HEADER, row=start)
    first = start + 1

    for i, r in enumerate(data["BOQ"]):
        row = first + i
        vals = [r[0], r[1], r[2].strip(), num(r[3]), num(r[4]),
                num(r[5]), r[6], r[7], r[8].strip(), r[9].strip()]
        for c, v in enumerate(vals, start=1):
            cell = ws.cell(row=row, column=c, value=v)
            cell.border = BOX
            cell.alignment = Alignment(vertical="top", wrap_text=(c in (2, 7, 8)))
        if i % 2:
            for c in range(1, len(BOQ_HEADER) + 1):
                ws.cell(row=row, column=c).fill = BAND_FILL
        if r[3].strip() == "?":
            ws.cell(row=row, column=4).fill = WARN_FILL
            ws.cell(row=row, column=6).fill = WARN_FILL

    last = first + len(data["BOQ"])
    # Total Qty stays as the CSV states it. It is NOT recomputed here: the CSV
    # is the authority, and self_check() reports any row where the stated
    # Total Qty disagrees with Quantity x (1 + Wastage %).

    add_list_validation(ws, "J", first, first + 499, STATUSES, "Status (§23)",
                        "One of: " + ", ".join(STATUSES))
    add_list_validation(ws, "I", first, first + 499, BASES, "Basis (§13 r6)",
                        "plan / slope / gross face / net face / developed girth")
    add_list_validation(ws, "C", first, first + 499, UNITS, "Unit",
                        "m3, m2, lin. m, No, kg, bags, sheets, tonnes")
    add_list_validation(ws, "E", first, first + 499,
                        [str(w) for w in WASTAGE], "Wastage % (§0.2)",
                        "Defaults: concrete 10, brickwork 10, mortar 10, rebar 7, "
                        "mesh 10, sheeting 10, timber 10, tiles 10")

    ws.conditional_formatting.add(
        f"J{first}:J{last}",
        FormulaRule(formula=[f'OR(J{first}="assumed",J{first}="by-schedule",'
                             f'J{first}="by-client-spec")'],
                    fill=WARN_FILL, stopIfTrue=False))

    ws.freeze_panes = f"C{first}"
    ws.auto_filter.ref = f"A{start}:J{last}"
    widths(ws, {"A": 8, "B": 46, "C": 9, "D": 11, "E": 10, "F": 11,
                "G": 44, "H": 34, "I": 15, "J": 15})


def build_summary(wb: Workbook, data: dict) -> None:
    ws = wb["Summary"]
    ws.sheet_properties.tabColor = TAB_COLOURS["Summary"]
    hdr_row = write_notes(ws, data["notes"].get("Summary", []))
    hdr = ["Trades", "Quantity", "Unit", "Order Qty (incl. wastage)", "Status"]
    write_header(ws, hdr, row=hdr_row)
    first = hdr_row + 1

    for i, r in enumerate(data["Summary"]):
        row = first + i
        for c, v in enumerate([r[0], num(r[1]), r[2].strip(),
                               num(r[3]), r[4].strip()], start=1):
            cell = ws.cell(row=row, column=c, value=v)
            cell.border = BOX
            cell.alignment = Alignment(vertical="top", wrap_text=(c == 1))
        if i % 2:
            for c in range(1, 6):
                ws.cell(row=row, column=c).fill = BAND_FILL

    add_list_validation(ws, "E", first, first + 59, STATUSES, "Status (§23)",
                        "One of: " + ", ".join(STATUSES))
    ws.conditional_formatting.add(
        f"E{first}:E{first + len(data['Summary']) - 1}",
        FormulaRule(formula=[f'E{first}="verified"'], fill=OK_FILL, stopIfTrue=False))
    ws.freeze_panes = f"A{first}"
    widths(ws, {"A": 42, "B": 14, "C": 12, "D": 24, "E": 16})


def build_takeoff(wb: Workbook, data: dict) -> None:
    ws = wb.create_sheet("Take-off")
    ws.sheet_properties.tabColor = TAB_COLOURS["Take-off"]
    hdr_row = write_notes(ws, data["notes"].get("Take-off", []))
    write_header(ws, TAKEOFF_HEADER, row=hdr_row)
    first = hdr_row + 1

    for i, r in enumerate(data["Take-off"]):
        row = first + i
        vals = [r[0], num(r[1]), num(r[2]), num(r[3]), num(r[4]), num(r[5]),
                r[6], num(r[7]), num(r[8]), num(r[9]), r[10].strip(),
                r[11], r[12]]
        for c, v in enumerate(vals, start=1):
            cell = ws.cell(row=row, column=c, value=v)
            cell.border = BOX
            cell.alignment = Alignment(vertical="top", wrap_text=(c in (1, 7, 12, 13)))
            if c in (2, 3, 4, 5, 6):
                cell.number_format = "0.00"
        if i % 2:
            for c in range(1, len(TAKEOFF_HEADER) + 1):
                ws.cell(row=row, column=c).fill = BAND_FILL

    add_list_validation(ws, "K", first, first + 299, UNITS, "Unit",
                        "m3, m2, lin. m, No, kg, bags, sheets, tonnes")
    ws.freeze_panes = f"B{first}"
    widths(ws, {"A": 46, "B": 11, "C": 10, "D": 15, "E": 12, "F": 13, "G": 30,
                "H": 10, "I": 12, "J": 10, "K": 9, "L": 42, "M": 34})


def build_verify(wb: Workbook, data: dict) -> None:
    ws = wb.create_sheet("Assumptions & Verify")
    ws.sheet_properties.tabColor = TAB_COLOURS["Assumptions & Verify"]
    hdr_row = write_notes(ws, data["notes"].get("Assumptions & Verify", []))
    write_header(ws, ["Item", "Assumption/Question", "Verified/To verify"],
                 row=hdr_row)
    first = hdr_row + 1

    for i, r in enumerate(data["Assumptions & Verify"]):
        row = first + i
        if r[0].strip() == "Section":       # the legend row, not real data
            continue
        for c, v in enumerate([r[0], r[1], r[2]], start=1):
            cell = ws.cell(row=row, column=c, value=v.strip())
            cell.border = BOX
            cell.alignment = Alignment(vertical="top", wrap_text=(c == 2))
        verdict = r[2].strip().lower()
        fill = OK_FILL if verdict.startswith("verified") else WARN_FILL
        ws.cell(row=row, column=3).fill = fill
        if i % 2:
            for c in (1, 2):
                ws.cell(row=row, column=c).fill = BAND_FILL

    add_list_validation(ws, "C", first, first + 299,
                        ["Verified", "To verify", "To verify - refer to the engineer",
                         "To verify - question for the engineer"],
                        "Verified/To verify",
                        "Say which, and never leave it blank (§13 rule 8)")
    ws.freeze_panes = f"A{first}"
    ws.auto_filter.ref = f"A{hdr_row}:C{first + len(data['Assumptions & Verify']) - 1}"
    widths(ws, {"A": 10, "B": 92, "C": 34})


def build_norms(wb: Workbook, data: dict) -> None:
    ws = wb.create_sheet("Norms")
    ws.sheet_properties.tabColor = TAB_COLOURS["Norms"]
    hdr_row = write_notes(ws, data["notes"].get("Norms", []))
    write_header(ws, ["Norm §", "Value used", "SANS citation", "Edition", "Status"],
                 row=hdr_row)
    first = hdr_row + 1

    for i, r in enumerate(data["Norms"]):
        row = first + i
        for c, v in enumerate([r[0], r[1], r[2], r[3], r[4].strip()], start=1):
            cell = ws.cell(row=row, column=c, value=v.strip())
            cell.border = BOX
            cell.alignment = Alignment(vertical="top", wrap_text=(c == 2))
        # §0.1 citation gate — an unconfirmed edition makes the rate `assumed`.
        if "to confirm" in r[3].lower() or r[4].strip() == "assumed":
            ws.cell(row=row, column=4).fill = WARN_FILL
            ws.cell(row=row, column=5).fill = WARN_FILL

    add_list_validation(ws, "E", first, first + 299, STATUSES, "Status (§23)",
                        "verified = edition confirmed; assumed = edition to confirm (§0.1)")
    ws.freeze_panes = f"A{first}"
    ws.auto_filter.ref = f"A{hdr_row}:E{first + len(data['Norms']) - 1}"
    widths(ws, {"A": 10, "B": 74, "C": 24, "D": 20, "E": 14})


def build_output(wb: Workbook, data: dict) -> None:
    ws = wb.create_sheet("Output")
    ws.sheet_properties.tabColor = TAB_COLOURS["Output"]
    ws.cell(row=1, column=1,
            value="§13 rule 13 — the three closing blocks, in this order."
            ).font = TITLE_FONT
    ws.cell(row=2, column=1,
            value="MATERIALS TAKE-OFF ONLY — NOT A PRICED BOQ (§22)."
            ).font = TITLE_FONT

    row = 4
    for line in data["Output"]:
        s = line.rstrip()
        if set(s) <= {"=", " "}:                       # ==== rule lines
            cell = ws.cell(row=row, column=1, value=s)
            cell.font = Font(bold=True, color="1F3864")
        elif s.upper().startswith("BLOCK "):
            cell = ws.cell(row=row, column=1, value=s)
            cell.font = Font(bold=True, size=12, color="FFFFFF")
            cell.fill = HDR_FILL
        elif s.startswith("  ") and s.strip():
            ws.cell(row=row, column=1, value=s.strip()).font = Font(size=10)
            ws.cell(row=row, column=1).alignment = Alignment(wrap_text=False)
        else:
            cell = ws.cell(row=row, column=1, value=s)
            cell.font = Font(bold=True, size=10)
        row += 1

    widths(ws, {"A": 104})


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--no-backup", action="store_true",
                    help="overwrite an existing workbook without keeping a copy")
    ap.add_argument("--check-only", action="store_true",
                    help="parse and self-check, but write nothing")
    args = ap.parse_args()

    try:
        data = parse(read_lines())
    except ParseError as e:
        print(f"PARSE FAILURE: {e}", file=sys.stderr)
        return 2

    print(f"Parsed  BOQ {len(data['BOQ'])} rows · "
          f"Summary {len(data['Summary'])} · "
          f"Take-off {len(data['Take-off'])} · "
          f"Verify {len(data['Assumptions & Verify'])} · "
          f"Norms {len(data['Norms'])} · "
          f"Output {len(data['Output'])} lines")

    problems = self_check(data)
    if problems:
        print(f"\n{len(problems)} SELF-CHECK FAILURE(S):", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        return 1
    print("Self-check passed (§13 rules 5, 6, 8; §23 status vocabulary).")

    if args.check_only:
        return 0

    if XLSX_PATH.exists() and not args.no_backup:
        bak = XLSX_PATH.with_suffix(f".bak-{date.today():%Y%m%d}.xlsx")
        shutil.copy2(XLSX_PATH, bak)
        print(f"Backed up existing workbook -> {bak.name}")

    wb = Workbook()
    wb.remove(wb.active)                    # drop the default sheet
    wb.create_sheet("Summary")
    build_boq(wb, data)
    build_summary(wb, data)
    build_takeoff(wb, data)
    build_verify(wb, data)
    build_norms(wb, data)
    build_output(wb, data)

    order = [wb[name] for name in SHEET_ORDER]
    wb._sheets = order                      # enforce §23 layout order
    wb.active = 0

    props = wb.properties
    props.title = "Plans / BOQ — Bill of Quantities (materials take-off)"
    props.subject = "Generated from boq-template.csv per sa-estimation-norms v2.0"
